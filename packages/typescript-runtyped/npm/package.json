    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/runtyped/TypeScript.git"
    },
    "keywords": [
        "typescript",
        "tsc",
        "compiler",
        "runtime-type-reflection",
        "runtyped"
    ],
    "os": [
